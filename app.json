{
  "expo": {
    "name": "RxCheck",
    "slug": "rx-check",
    "scheme": "rxcheck",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rx/Check to photograph a prescription for on-device text recognition.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rx/Check to select a prescription image for on-device text recognition."
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "vision"
        }
      ],
      "./plugins/withPaddleOcrMinSdk",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.rxcheck.app",
      "versionCode": 6,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/rxcheck-icon.png",
        "backgroundColor": "#117F74"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/rxcheck-icon.png",
    "splash": {
      "image": "./assets/brand/rxcheck-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5FAF8"
    }
  }
}
